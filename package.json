{
  "name": "novel-observer",
  "version": "0.3.1",
  "private": true,
  "description": "以 Git 仓库承载作品、桥接通用 Agent 的本地长篇网文写作工作台",
  "author": "Novel Observer contributors",
  "type": "module",
  "main": "dist-electron/electron/main/index.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"tsc -p electron/tsconfig.json --watch --preserveWatchOutput --noEmit\" \"wait-on http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run typecheck && vite build && tsc -p electron/tsconfig.json",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run audit:generic",
    "doctor": "node --import tsx scripts/doctor.ts",
    "demo": "node --import tsx scripts/create-demo.ts",
    "e2e:high-wuxia": "node --import tsx scripts/bootstrap-high-wuxia.ts",
    "audit:novel": "node --import tsx scripts/audit-novel.ts",
    "audit:features": "node --import tsx scripts/audit-feature-coverage.ts",
    "audit:generic": "node --import tsx scripts/audit-generic-core.ts",
    "e2e:advance-high-wuxia": "node --import tsx scripts/advance-high-wuxia.ts",
    "e2e:advance-fifth-volume": "node --import tsx scripts/advance-fifth-volume.ts",
    "e2e:advance-sixth-volume": "node --import tsx scripts/advance-sixth-volume.ts",
    "e2e:advance-seventh-volume": "node --import tsx scripts/advance-seventh-volume.ts",
    "checkpoint:novel": "node --import tsx scripts/checkpoint-novel.ts",
    "e2e:review-high-wuxia": "node --import tsx scripts/review-high-wuxia.ts",
    "e2e:review-ninefold": "node --import tsx scripts/review-ninefold-fight.ts",
    "e2e:recovery-conflict": "node --import tsx scripts/exercise-recovery-conflict.ts",
    "e2e:context-search": "node --import tsx scripts/exercise-context-search.ts",
    "e2e:complete-high-wuxia-research": "node --import tsx scripts/complete-high-wuxia-research.ts",
    "e2e:style-profile": "node --import tsx scripts/exercise-style-profile.ts",
    "e2e:organize-high-wuxia": "node --import tsx scripts/organize-high-wuxia.ts",
    "e2e:replan-high-wuxia": "node --import tsx scripts/replan-high-wuxia.ts",
    "smoke:agent": "node --import tsx scripts/smoke-agent.ts",
    "accept:real-agent": "node --import tsx scripts/accept-real-agent.ts",
    "accept:comment-feedback": "node --import tsx scripts/accept-comment-feedback.ts",
    "accept:local-features": "node --import tsx scripts/accept-local-features.ts",
    "accept:cross-genre": "node --import tsx scripts/accept-cross-genre.ts",
    "accept:ui": "node --import tsx scripts/record-ui-acceptance.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@git-diff-view/file": "^0.1.7",
    "@git-diff-view/react": "^0.1.7",
    "@uiw/react-codemirror": "^4.25.2",
    "chokidar": "^4.0.3",
    "diff": "^8.0.2",
    "diff-match-patch": "^1.0.5",
    "fast-glob": "^3.3.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.novelobserver.workbench",
    "productName": "叙舟",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "icon": "assets/icon.ico"
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
