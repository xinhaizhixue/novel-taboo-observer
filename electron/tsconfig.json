{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "../dist-electron",
    "rootDir": "..",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.cts", "../src/shared/**/*.ts"]
}
